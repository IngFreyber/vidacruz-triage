# Copia este archivo a .env y completa los valores. NUNCA commitees .env

# --- LLM (Google Gemini via endpoint compatible con OpenAI) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=coloca-tu-api-key-de-google-ai-studio
LLM_MODEL=gemini-3.5-flash

# --- API Keys de acceso a los endpoints (header X-API-Key). Obligatorias, mínimo 16 caracteres.
#     Varias claves separadas por coma permiten rotarlas sin cortar el servicio. ---
TRIAGE_API_KEY=cambia-esta-clave-triage
ASISTENTE_API_KEY=cambia-esta-clave-asistente
ALERTAS_API_KEY=cambia-esta-clave-alertas

# --- Webhook opcional de Microsoft Teams para RF-06 (vacio = deshabilitado) ---
TEAMS_WEBHOOK_URL=

# --- Infraestructura local ---
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage_local_pwd
# Puerto publicado en el host (15432 evita conflicto con un PostgreSQL local en 5432)
POSTGRES_HOST_PORT=15432

# --- Observabilidad (opcional) ---
# true + 'docker compose --profile observabilidad up' envía las trazas a Jaeger (http://localhost:16686)
# TRACING_EXPORTAR=false
# Fuera de Docker: exportador OTLP de trazas, p. ej. http://localhost:4318/v1/traces
# MANAGEMENT_OTLP_TRACING_ENDPOINT=
# Formato de logs: ecs (JSON, por defecto) o vacío para formato legible
# LOG_FORMATO=

# --- SLA por nivel y frecuencia del monitor (opcional; formato Duration: 30s, 5m) ---
# Útil para ver escalamientos en segundos: SLA_CRITICO=20s y TRIAGE_ESCALAMIENTO_INTERVALO=3s
# SLA_CRITICO=5m
# SLA_URGENTE=10m
# SLA_URGENTE_2=30m
# SLA_NO_URGENTE=60m
# SLA_NO_URGENTE_2=120m
# TRIAGE_ESCALAMIENTO_INTERVALO=30s
